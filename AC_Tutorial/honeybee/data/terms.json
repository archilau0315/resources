 {"en": "GHI", "zh": "水平总辐射", "note": "水平面接收的直射与散射之和。"},
 {"en": "Illuminance", "zh": "照度", "note": "单位面积光通量，lux。"},
 {"en": "Irradiance", "zh": "辐照度", "note": "单位面积辐射功率，W/m²。"},
 {"en": "Luminance", "zh": "亮度", "note": "单位面积发光强度，cd/m²。"},
 {"en": "Glare", "zh": "眩光", "note": "过亮或亮度过大对比引起的不适。"}
