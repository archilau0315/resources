[
 {"en": "Ladybug", "zh": "瓢虫", "note": "气象与环境数据分析工具集，负责 EPW、太阳、舒适度与图表。"},
 {"en": "Honeybee", "zh": "蜜蜂", "note": "建筑几何与围护结构建模工具集，衔接能量与采光模拟。"},
 {"en": "Dragonfly", "zh": "蜻蜓", "note": "城市与街区尺度建模工具集，本项目不涉及。"},
 {"en": "Pollination", "zh": "授粉平台", "note": "官方云平台与一键安装器，可托管模拟与结果。"},
